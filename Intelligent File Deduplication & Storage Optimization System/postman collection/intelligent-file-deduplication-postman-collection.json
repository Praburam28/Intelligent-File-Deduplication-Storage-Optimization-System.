                "exec": [
                  "pm.test('Upload accepted', function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 201, 202]);",
                  "});",
                  "try {",
                  "    const data = pm.response.json();",
                  "    if (data.id) pm.environment.set('file_id', String(data.id));",
                  "} catch (e) {}"
                ]
              }

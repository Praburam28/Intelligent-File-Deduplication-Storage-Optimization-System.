  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "username",
      "value": "testuser"
    },
    {
      "key": "password",
      "value": "Test@12345"
    },
    {
      "key": "file_id",
      "value": ""
    },
